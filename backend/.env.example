# Google Calendar Configuration
CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Timezone (IANA format)
TIMEZONE=Europe/Prague

# Room name displayed in the UI
ROOM_NAME=Zasedací místnost

# How often to refresh events (seconds)
REFRESH_INTERVAL_SECONDS=30

# Google Service Account credentials (use ONE of these options)
# Option 1: JSON string (for deployment platforms like Vercel, Render)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'

# Option 2: Path to JSON file (for local development)
# GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json

# Server configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000
